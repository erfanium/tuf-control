<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>TUF Control</vendor>
  <action id="io.github.erfanium.TufControl.helper">
    <description>Change CPU power limits and fan curve settings</description>
    <message>Authentication is required to change CPU power limits</message>
    <icon_name>io.github.erfanium.TufControl</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/tuf-control-helper</annotate>
  </action>
</policyconfig>
